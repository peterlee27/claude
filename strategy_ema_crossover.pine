// =============================================================================
// Strategy 1: EMA Crossover — GBP/JPY Backtesting Strategy
// =============================================================================
// Logic: Fast EMA (9) crosses above Slow EMA (21) → Long
//        Fast EMA (9) crosses below Slow EMA (21) → Short
// Risk:  ATR-based stop loss (1.5x ATR), take profit at 2:1 reward-to-risk
// =============================================================================

//@version=5
strategy("EMA Crossover | GBP/JPY", overlay=true,
     initial_capital=10000, currency=currency.USD,
     default_qty_type=strategy.fixed, default_qty_value=1000,
     commission_type=strategy.commission.percent, commission_value=0.01,
     process_orders_on_close=false)

// ── Inputs ──────────────────────────────────────────────────────────────────
fastLen   = input.int(9,   "Fast EMA Length", minval=1)
slowLen   = input.int(21,  "Slow EMA Length", minval=1)
atrLen    = input.int(14,  "ATR Length",      minval=1)
atrSlMult = input.float(1.5, "ATR Stop Loss Multiplier", step=0.1)
rrRatio   = input.float(2.0, "Reward-to-Risk Ratio",     step=0.1)

// ── Calculations ────────────────────────────────────────────────────────────
fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)
atrVal  = ta.atr(atrLen)

// ── Signals ─────────────────────────────────────────────────────────────────
longSignal  = ta.crossover(fastEma, slowEma)
shortSignal = ta.crossunder(fastEma, slowEma)

// ── Entries & Exits ─────────────────────────────────────────────────────────
if longSignal
    sl = close - atrVal * atrSlMult
    tp = close + atrVal * atrSlMult * rrRatio
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=sl, limit=tp)

if shortSignal
    sl = close + atrVal * atrSlMult
    tp = close - atrVal * atrSlMult * rrRatio
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=sl, limit=tp)

// ── Plots ───────────────────────────────────────────────────────────────────
plot(fastEma, "Fast EMA", color=color.new(color.blue, 0), linewidth=2)
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0), linewidth=2)

plotshape(longSignal,  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small, title="Buy Signal")
plotshape(shortSignal, style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, title="Sell Signal")

// ── Performance Summary Table ───────────────────────────────────────────────
var table perfTable = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islastconfirmedhistory
    table.cell(perfTable, 0, 0, "Metric",         text_color=color.white, text_size=size.small)
    table.cell(perfTable, 1, 0, "Value",           text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 1, "Strategy",        text_color=color.gray,  text_size=size.small)
    table.cell(perfTable, 1, 1, "EMA Crossover",   text_color=color.yellow,text_size=size.small)
    table.cell(perfTable, 0, 2, "Net Profit",      text_color=color.gray,  text_size=size.small)
    table.cell(perfTable, 1, 2, str.tostring(strategy.netprofit, "#,##0.00") + " USD", text_color=strategy.netprofit >= 0 ? color.green : color.red, text_size=size.small)
    table.cell(perfTable, 0, 3, "Total Trades",    text_color=color.gray,  text_size=size.small)
    table.cell(perfTable, 1, 3, str.tostring(strategy.closedtrades),       text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 4, "Win Rate",        text_color=color.gray,  text_size=size.small)
    winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0.0
    table.cell(perfTable, 1, 4, str.tostring(winRate, "#0.1") + "%",       text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 5, "Profit Factor",   text_color=color.gray,  text_size=size.small)
    table.cell(perfTable, 1, 5, str.tostring(strategy.grossprofit / math.max(strategy.grossloss, 1), "#0.00"), text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 6, "Max Drawdown",    text_color=color.gray,  text_size=size.small)
    table.cell(perfTable, 1, 6, str.tostring(strategy.max_drawdown, "#,##0.00") + " USD", text_color=color.red, text_size=size.small)
