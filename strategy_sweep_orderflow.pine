// =============================================================================
// Strategy 4: Liquidity Sweep + Order Flow Confluence — GBP/JPY
// =============================================================================
// Concept: Combines Liquidity Sweep detection with Order Flow confirmation.
//          Only takes sweep trades when volume/delta confirms institutional
//          participation. This filters out weak sweeps and improves win rate.
//
// Logic:   1. Detect swing high/low sweep (liquidity grab)
//          2. Confirm with volume spike (institutional participation)
//          3. Confirm with delta direction (buy/sell pressure alignment)
//          4. Enter with tight SL beyond sweep, TP at 3:1 R:R
// =============================================================================

//@version=5
strategy("Sweep + Order Flow | GBP/JPY", overlay=true,
     initial_capital=10000, currency=currency.USD,
     default_qty_type=strategy.fixed, default_qty_value=1000,
     commission_type=strategy.commission.percent, commission_value=0.01,
     process_orders_on_close=false)

// ── Inputs ──────────────────────────────────────────────────────────────────
pivotLeft    = input.int(5,    "Pivot Lookback Left",       minval=2)
pivotRight   = input.int(2,    "Pivot Lookback Right",      minval=1)
volAvgLen    = input.int(20,   "Volume Average Length",     minval=5)
volSpikeMult = input.float(1.5, "Volume Spike Multiplier",  step=0.1)
deltaLen     = input.int(3,    "Delta Lookback (bars)",     minval=1)
rrRatio      = input.float(3.0, "Reward-to-Risk Ratio",    step=0.1)
slBuffer     = input.float(5,  "SL Buffer (pips)",          step=1)
maxSlPips    = input.float(70, "Max Stop Loss (pips)",      step=5)

// ── Pip Calculation ─────────────────────────────────────────────────────────
pipSize = syminfo.mintick * 10

// ── Swing High/Low Detection ────────────────────────────────────────────────
swingHigh = ta.pivothigh(high, pivotLeft, pivotRight)
swingLow  = ta.pivotlow(low, pivotLeft, pivotRight)

var float lastSwingHigh = na
var float lastSwingLow  = na

if not na(swingHigh)
    lastSwingHigh := swingHigh
if not na(swingLow)
    lastSwingLow := swingLow

// ── Volume Delta Approximation ──────────────────────────────────────────────
candleRange = high - low
buyVolume   = candleRange > 0 ? volume * (close - low) / candleRange : 0
sellVolume  = candleRange > 0 ? volume * (high - close) / candleRange : 0
delta       = buyVolume - sellVolume
cumDelta    = math.sum(delta, deltaLen)

// ── Volume Analysis ─────────────────────────────────────────────────────────
avgVolume = ta.sma(volume, volAvgLen)
volSpike  = volume > avgVolume * volSpikeMult

// ── Sweep + Order Flow Confluence ───────────────────────────────────────────
// Bullish: sweep below swing low + volume spike + positive delta (buyers stepping in)
sweepBelowWithFlow = not na(lastSwingLow) and
                     low < lastSwingLow and
                     close > lastSwingLow and
                     close > open and       // bullish candle
                     volSpike and            // institutional volume
                     cumDelta > 0            // buying pressure

// Bearish: sweep above swing high + volume spike + negative delta (sellers stepping in)
sweepAboveWithFlow = not na(lastSwingHigh) and
                     high > lastSwingHigh and
                     close < lastSwingHigh and
                     close < open and       // bearish candle
                     volSpike and           // institutional volume
                     cumDelta < 0           // selling pressure

// ── Entries ─────────────────────────────────────────────────────────────────
if sweepBelowWithFlow
    slDistance = math.min(close - low + slBuffer * pipSize, maxSlPips * pipSize)
    sl = close - slDistance
    tp = close + slDistance * rrRatio
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=sl, limit=tp)
    lastSwingLow := na

if sweepAboveWithFlow
    slDistance = math.min(high - close + slBuffer * pipSize, maxSlPips * pipSize)
    sl = close + slDistance
    tp = close - slDistance * rrRatio
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=sl, limit=tp)
    lastSwingHigh := na

// ── Plots ───────────────────────────────────────────────────────────────────
plot(lastSwingHigh, "Swing High", color=color.new(color.red, 40),   style=plot.style_stepline, linewidth=1)
plot(lastSwingLow,  "Swing Low",  color=color.new(color.green, 40), style=plot.style_stepline, linewidth=1)

// Volume confirmation markers
plotshape(volSpike and not sweepBelowWithFlow and not sweepAboveWithFlow, style=shape.diamond, location=location.abovebar, color=color.new(color.yellow, 50), size=size.tiny, title="Vol Spike")

plotshape(sweepBelowWithFlow, style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small, title="Sweep+Flow Buy")
plotshape(sweepAboveWithFlow, style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, title="Sweep+Flow Sell")

// Delta bias background
bgcolor(cumDelta > 0 ? color.new(color.green, 96) : color.new(color.red, 96), title="Delta Bias")

// ── Performance Summary Table ───────────────────────────────────────────────
var table perfTable = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islastconfirmedhistory
    table.cell(perfTable, 0, 0, "Metric",            text_color=color.white,  text_size=size.small)
    table.cell(perfTable, 1, 0, "Value",              text_color=color.white,  text_size=size.small)
    table.cell(perfTable, 0, 1, "Strategy",           text_color=color.gray,   text_size=size.small)
    table.cell(perfTable, 1, 1, "Sweep + Flow",       text_color=color.yellow, text_size=size.small)
    table.cell(perfTable, 0, 2, "Net Profit",         text_color=color.gray,   text_size=size.small)
    table.cell(perfTable, 1, 2, str.tostring(strategy.netprofit, "#,##0.00") + " USD", text_color=strategy.netprofit >= 0 ? color.green : color.red, text_size=size.small)
    table.cell(perfTable, 0, 3, "Total Trades",       text_color=color.gray,   text_size=size.small)
    table.cell(perfTable, 1, 3, str.tostring(strategy.closedtrades), text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 4, "Win Rate",           text_color=color.gray,   text_size=size.small)
    winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0.0
    table.cell(perfTable, 1, 4, str.tostring(winRate, "#0.1") + "%", text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 5, "Profit Factor",      text_color=color.gray,   text_size=size.small)
    table.cell(perfTable, 1, 5, str.tostring(strategy.grossprofit / math.max(strategy.grossloss, 1), "#0.00"), text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 6, "Max Drawdown",       text_color=color.gray,   text_size=size.small)
    table.cell(perfTable, 1, 6, str.tostring(strategy.max_drawdown, "#,##0.00") + " USD", text_color=color.red, text_size=size.small)
