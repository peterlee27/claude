// =============================================================================
// Strategy 3: AMD Session Model — GBP/JPY Backtesting Strategy
// =============================================================================
// Concept: Accumulation → Manipulation → Distribution (ICT / Smart Money)
//
//   Asian Session (00:00–08:00 UTC) = ACCUMULATION
//     Price consolidates in a range. Mark the session high and low.
//
//   London Open (08:00–10:00 UTC) = MANIPULATION
//     Price sweeps the Asian range high or low (fake breakout / liquidity grab).
//
//   London/NY Session (10:00–16:00 UTC) = DISTRIBUTION
//     After the manipulation sweep, price moves in the true direction.
//     Enter on the reversal after the sweep for the distribution move.
//
// Logic:   1. Track Asian session high/low (accumulation range)
//          2. Detect London open sweep of Asian range (manipulation)
//          3. Enter on reversal candle after sweep (distribution)
//          4. TP at 2–3x the Asian range, SL beyond sweep wick
// =============================================================================

//@version=6
strategy("AMD Session Model | GBP/JPY", overlay=true,
     initial_capital=10000, currency=currency.USD,
     default_qty_type=strategy.fixed, default_qty_value=1000,
     commission_type=strategy.commission.percent, commission_value=0.01,
     process_orders_on_close=false)

// ── Inputs ──────────────────────────────────────────────────────────────────
asianStart   = input.int(0,   "Asian Session Start (UTC hour)", minval=0, maxval=23)
asianEnd     = input.int(8,   "Asian Session End (UTC hour)",   minval=0, maxval=23)
manipEnd     = input.int(10,  "Manipulation Window End (UTC)",  minval=0, maxval=23)
distEnd      = input.int(16,  "Distribution Window End (UTC)",  minval=0, maxval=23)
sweepPips    = input.float(3, "Min Sweep Beyond Range (pips)",  step=1)
rrRatio      = input.float(2.5, "Reward-to-Risk Ratio",        step=0.1)
slBuffer     = input.float(5,  "SL Buffer Beyond Sweep (pips)", step=1)
maxSlPips    = input.float(70, "Max Stop Loss (pips)",          step=5)

// ── Pip Calculation ─────────────────────────────────────────────────────────
pipSize = syminfo.mintick * 10

// ── Session Time Detection (UTC) ────────────────────────────────────────────
currentHour = hour(time, "UTC")

isAsianSession = currentHour >= asianStart and currentHour < asianEnd
isManipWindow  = currentHour >= asianEnd   and currentHour < manipEnd
isDistWindow   = currentHour >= manipEnd   and currentHour < distEnd

// ── Track Asian Range ───────────────────────────────────────────────────────
var float asianHigh    = na
var float asianLow     = na
var bool  asianDefined = false
var bool  sweptHigh    = false
var bool  sweptLow     = false
var float sweepWick    = na
var bool  tradedToday  = false

// Reset at the start of each Asian session
if isAsianSession and not isAsianSession[1]
    asianHigh    := high
    asianLow     := low
    asianDefined := false
    sweptHigh    := false
    sweptLow     := false
    sweepWick    := na
    tradedToday  := false

// Build the Asian range during the session
if isAsianSession
    asianHigh := math.max(asianHigh, high)
    asianLow  := math.min(asianLow, low)

// Mark Asian range as defined when session ends
if not isAsianSession and isAsianSession[1]
    asianDefined := true

// ── Manipulation Detection (London Open) ────────────────────────────────────
asianRange = asianHigh - asianLow
minSweep   = sweepPips * pipSize

// Bearish manipulation: sweeps Asian high then closes back below
manipSweepHigh = isManipWindow and asianDefined and not sweptHigh and
                 high > asianHigh + minSweep and
                 close < asianHigh and
                 close < open  // bearish candle

// Bullish manipulation: sweeps Asian low then closes back above
manipSweepLow = isManipWindow and asianDefined and not sweptLow and
                low < asianLow - minSweep and
                close > asianLow and
                close > open  // bullish candle

if manipSweepHigh
    sweptHigh := true
    sweepWick := high

if manipSweepLow
    sweptLow  := true
    sweepWick := low

// ── Distribution Entries ────────────────────────────────────────────────────
// Enter during manipulation or early distribution window after sweep confirmation
longSignal  = manipSweepLow  and not tradedToday
shortSignal = manipSweepHigh and not tradedToday

if longSignal
    slDistance = math.min(close - sweepWick + slBuffer * pipSize, maxSlPips * pipSize)
    sl = close - slDistance
    tp = close + slDistance * rrRatio
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=sl, limit=tp)
    tradedToday := true

if shortSignal
    slDistance = math.min(sweepWick - close + slBuffer * pipSize, maxSlPips * pipSize)
    sl = close + slDistance
    tp = close - slDistance * rrRatio
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=sl, limit=tp)
    tradedToday := true

// Close any open positions at end of distribution window
if currentHour >= distEnd and strategy.position_size != 0
    strategy.close_all(comment="Session End")

// ── Plots ───────────────────────────────────────────────────────────────────
// Asian range visualization
asianHighPlot = plot(asianDefined ? asianHigh : na, "Asian High", color=color.new(color.red, 50), style=plot.style_stepline, linewidth=1)
asianLowPlot  = plot(asianDefined ? asianLow  : na, "Asian Low",  color=color.new(color.green, 50), style=plot.style_stepline, linewidth=1)
fill(asianHighPlot, asianLowPlot, color=color.new(color.gray, 90), title="Asian Range")

// Session background colors
bgcolor(isAsianSession ? color.new(color.blue, 95)   : na, title="Asian Session")
bgcolor(isManipWindow  ? color.new(color.orange, 95)  : na, title="Manipulation Window")
bgcolor(isDistWindow   ? color.new(color.green, 97)   : na, title="Distribution Window")

plotshape(longSignal,  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small, title="AMD Buy")
plotshape(shortSignal, style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, title="AMD Sell")

// ── Performance Summary Table ───────────────────────────────────────────────
var table perfTable = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islastconfirmedhistory
    table.cell(perfTable, 0, 0, "Metric",            text_color=color.white,  text_size=size.small)
    table.cell(perfTable, 1, 0, "Value",              text_color=color.white,  text_size=size.small)
    table.cell(perfTable, 0, 1, "Strategy",           text_color=color.gray,   text_size=size.small)
    table.cell(perfTable, 1, 1, "AMD Model",          text_color=color.yellow, text_size=size.small)
    table.cell(perfTable, 0, 2, "Net Profit",         text_color=color.gray,   text_size=size.small)
    table.cell(perfTable, 1, 2, str.tostring(strategy.netprofit, "#,##0.00") + " USD", text_color=strategy.netprofit >= 0 ? color.green : color.red, text_size=size.small)
    table.cell(perfTable, 0, 3, "Total Trades",       text_color=color.gray,   text_size=size.small)
    table.cell(perfTable, 1, 3, str.tostring(strategy.closedtrades), text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 4, "Win Rate",           text_color=color.gray,   text_size=size.small)
    winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0.0
    table.cell(perfTable, 1, 4, str.tostring(winRate, "#0.1") + "%", text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 5, "Profit Factor",      text_color=color.gray,   text_size=size.small)
    table.cell(perfTable, 1, 5, str.tostring(strategy.grossprofit / math.max(strategy.grossloss, 1), "#0.00"), text_color=color.white, text_size=size.small)
    table.cell(perfTable, 0, 6, "Max Drawdown",       text_color=color.gray,   text_size=size.small)
    table.cell(perfTable, 1, 6, str.tostring(strategy.max_drawdown, "#,##0.00") + " USD", text_color=color.red, text_size=size.small)
